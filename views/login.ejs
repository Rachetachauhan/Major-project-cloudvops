<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
</head>
<body>

<center>

    <h1>Welcome</h1>
    <h2>Login Page</h2>

    <hr>

    <form action="/login" method="post">

        <p>
            <label for="username">Username</label><br>
            <input
                type="text"
                id="username"
                name="username"
                placeholder="Enter Username"
                value=""
            >
        </p>

        <p>
            <label for="password">Password</label><br>
            <input
                type="password"
                id="password"
                name="password"
                placeholder="Enter Password"
                value=""
            >
        </p>


        <p>
            <input
                type="submit"
                name="login"
                value="Login"
            >

            <input
                type="reset"
                name="clear"
                value="Clear"
            >
        </p>

    </form>

    <hr>

    <p><a href="#">Forgot Password?</a></p>
    <p><a href="#">Create New Account</a></p>

</center>

</body>
</html>
